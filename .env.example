# Copy to .env for local `vercel dev`. Set the same two in the Vercel
# dashboard under Settings, Environment Variables.

# Your Anthropic key. Set a hard spend limit in the Anthropic console first.
ANTHROPIC_API_KEY=

# Shared access code for the deployed demo. The frontend reads it from ?k= in
# the URL. This is obfuscation, not security. See DEPLOY.md.
DEMO_KEY=
